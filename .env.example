# Local development only. Replace values before using outside localhost.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
POSTGRES_DB=claimflow
POSTGRES_USER=claimflow
POSTGRES_PASSWORD=local-development-password
POSTGRES_HOST=postgres
REDIS_URL=redis://redis:6379/1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
S3_BUCKET=claimflow
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=claimflow-local
S3_SECRET_KEY=local-object-storage-password
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4318

# RAG: opt in before processing real customer evidence through Groq and Gemini.
RAG_ENABLED=false
GROQ_API_KEY=
GEMINI_API_KEY=
RAG_CHAT_MODEL=openai/gpt-oss-120b
RAG_EMBEDDING_MODEL=gemini-embedding-001
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
RAG_COLLECTION=claimflow_gemini_policy_v1
